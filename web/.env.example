# Copy to web/.env. Only these public values belong here: everything in this file ships to the browser.
# Never put a service-role key or any other secret in this app.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-the-local-publishable-key
# Optional. The Android app store page, shown as a link and a QR code. Leave empty until the app is published.
VITE_ANDROID_APP_URL=
