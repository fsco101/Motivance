# Backend email setup only. Copy to ignored supabase/.env and fill locally.
# Never copy these values into android/.env or paste passwords into chat.
# Gmail SMTP defaults. Keep your sender's actual credentials in supabase/.env only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Your full Gmail sender address, for example your-account@gmail.com.
SMTP_USER=
# The sender's Google App Password (not the normal Gmail login password).
SMTP_PASS=
# Use the same address as SMTP_USER for this Gmail setup.
SMTP_FROM_EMAIL=
SMTP_SENDER_NAME=Motivance

# Booking email is sent by the notification-dispatch Edge Function, not by Auth. See docs/operations/NOTIFICATIONS.md.
# These are set as Edge secrets with `supabase secrets set`. Supabase blocks ports 25 and 587 there, so use 465.
# NOTIFICATION_SMTP_PORT=465
# NOTIFICATION_DISPATCH_SECRET=
# PUBLIC_SITE_URL=
# PUBLIC_FUNCTIONS_URL=

# Leave these empty for local Docker; required for hosted --apply.
# Project reference only (20 characters), not the full project URL.
SUPABASE_PROJECT_REF=
# Supabase personal access token for server configuration, not an anon/service key.
SUPABASE_ACCESS_TOKEN=

# After filling the sender fields, test TLS/login without sending email:
# python scripts/configure_auth_email.py --target local --check-smtp
# Apply real SMTP to local Docker:
# python scripts/configure_auth_email.py --target local --check-smtp --apply
# Or, after filling hosted fields, apply to the chosen hosted project:
# python scripts/configure_auth_email.py --target hosted --check-smtp --apply

# Cloudinary profile photos (docs/operations/CLOUDINARY.md). Stored in Supabase Vault by
# python scripts/configure_cloudinary.py --target local --check --apply
# Paste the dashboard's API environment variable: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
