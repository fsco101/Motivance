# Local-only development. Run python scripts/setup_local_env.py after Supabase starts.
SUPABASE_URL=http://127.0.0.1:54321
# Android emulator reaches the host through 10.0.2.2. Hosted environments require HTTPS.
ANDROID_SUPABASE_URL=http://10.0.2.2:54321
SUPABASE_PUBLISHABLE_KEY=
# Never add a service-role key, database password or signing credentials to the Android app.

# USB phone with adb reverse: set ANDROID_SUPABASE_URL=http://127.0.0.1:54321
# Hosted project: use its HTTPS URL and public sb_publishable_... key.
# Configuration guide: docs/operations/ENVIRONMENT.md

# Optional push notifications. Leave these empty until a Firebase project exists: the app builds and runs without them.
# They are public client values. The steps are in docs/operations/NOTIFICATIONS.md.
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_SENDER_ID=
